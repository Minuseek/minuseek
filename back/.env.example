PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=minuseek_dev
DB_USER=minuseek
DB_PASSWORD=change_me

DATABASE_URL=postgresql://minuseek:change_me@localhost:5432/minuseek_dev

ADMIN_DATABASE_URL=postgresql://minuseek:change_me@localhost:5432/minuseek_admin

# Template d'URL des bases tenant ({db} = database_name du registre)
TENANT_DATABASE_URL_TEMPLATE=postgresql://minuseek:change_me@localhost:5432/{db}

# Base jetable pour test 
INTEGRATION_DB_NAME=minuseek_integration
INTEGRATION_DB_PORT=5433

ORIGIN=http://localhost:5173,http://localhost:5174

FRONT_ORIGIN=http://localhost:5173

# Moteur de comparaison automatique (service externe, optionnel). Vide :
# l'analyse automatique est désactivée, le reste de l'application fonctionne.
DATA_API_URL=

KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_SYSTEM_REALM=minuseek-system
KEYCLOAK_AUDIENCE=minuseek-api
# Tolère un émetteur localhost/conteneur en dev. Ne JAMAIS activer en déployé.
KEYCLOAK_ISSUER_HOST_CHECK=lax
KEYCLOAK_ADMIN_CLIENT_ID=minuseek-provisioner
# Client mobile provisionné dans chaque realm tenant : autorise le redirect Expo Go
# (exp://*) EN DEV UNIQUEMENT. Ne JAMAIS le mettre à true en prod (fail-closed :
# absent/false = seul le scheme natif mobileminuseek:// est accepté).
MOBILE_ALLOW_EXPO_GO=true
# Realm créés par le provisioning : none en dev local (HTTP), external en déployé
KEYCLOAK_REALM_SSL_REQUIRED=none
KEYCLOAK_ADMIN_CLIENT_SECRET=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=change_me

# Stockage des pièces et des rapports :
#   local     : fichiers sur disque (volume Docker), servis par le back via URL signée
#   gcs       : bucket Google Cloud Storage privé, URL signées V4 (ADR-0003)
#   in-memory : aucune persistance, pour les tests
STORAGE_DRIVER=local
# Secret HMAC des URL signées (32 caractères minimum). À régénérer hors poste
# local : openssl rand -hex 32
LOCAL_STORAGE_SIGNING_SECRET=dev-only-local-storage-secret-change-me-0123456789
LOCAL_STORAGE_URL_TTL_SECONDS=900
# Adresse à laquelle le navigateur joint le back (le front et l'API sont sur deux
# origines en dev). Relative (/api/storage) si les deux sont derrière le même domaine.
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3000/api/storage
# Avec STORAGE_DRIVER=gcs : nom du bucket, et chemin des identifiants Google
# (GCLOUD_ADC, monté dans le conteneur)
GCS_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=900

# Horodatage RFC 3161 de la tête de chaîne d'audit (ADR-0009). En dev, TSA
# gratuite et publique ; en prod, TSA qualifiée eIDAS — c'est elle qui donne
# sa valeur probante à la datation.
TSA_URL=https://freetsa.org/tsr
TSA_TIMEOUT_MS=10000
